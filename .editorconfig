root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{m,h}]
indent_style = tab
tab_width = 4

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml,json,xml,plist,in}]
indent_style = space
indent_size = 2
